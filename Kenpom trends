<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KenPom Season Trends</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        h1 {
            color: white;
            text-align: center;
            margin-bottom: 30px;
            font-size: 2.5em;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        }

        .controls-container {
            background: white;
            border-radius: 10px;
            padding: 30px;
            margin-bottom: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .controls-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .control-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
            color: #333;
            font-size: 14px;
        }

        select {
            padding: 12px;
            font-size: 16px;
            border: 2px solid #ddd;
            border-radius: 5px;
            background: white;
            cursor: pointer;
            transition: border-color 0.3s;
        }

        select:focus {
            outline: none;
            border-color: #667eea;
        }

        .button-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        button {
            padding: 12px 30px;
            font-size: 16px;
            background: #667eea;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s;
            font-weight: 600;
        }

        button:hover {
            background: #5568d3;
        }

        button:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

        button.active {
            background: #764ba2;
        }

        .chart-container {
            background: white;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            display: none;
        }

        .chart-container.active {
            display: block;
        }

        .chart-wrapper {
            position: relative;
            height: 500px;
        }

        .loading {
            text-align: center;
            color: #667eea;
            font-size: 18px;
            padding: 20px;
            display: none;
        }

        .loading.active {
            display: block;
        }

        .error-message {
            background: #fee;
            color: #c33;
            padding: 15px;
            border-radius: 5px;
            margin-top: 10px;
            display: none;
        }

        .error-message.active {
            display: block;
        }

        .info-text {
            color: #666;
            font-size: 14px;
            margin-top: 10px;
        }

        .stats-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
        }

        .stat-label {
            font-size: 12px;
            opacity: 0.9;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 1.8em;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🏀 KenPom Season Trends</h1>
        
        <div class="controls-container">
            <div class="controls-grid">
                <div class="control-group">
                    <label for="teamSelect">Select Team:</label>
                    <select id="teamSelect">
                        <option value="">-- Choose a team --</option>
                    </select>
                </div>
                
                <div class="control-group">
                    <label for="yearSelect">Select Season:</label>
                    <select id="yearSelect">
                        <option value="2025">2024-2025</option>
                        <option value="2024">2023-2024</option>
                        <option value="2023">2022-2023</option>
                    </select>
                </div>
            </div>

            <div class="button-group">
                <button id="fetchBtn">Load Season Trends</button>
                <button id="toggleBtn" disabled>Show Rankings</button>
            </div>

            <p class="info-text">Select a team and season, then click "Load Season Trends" to see weekly KenPom metrics throughout the season.</p>
            <div class="error-message" id="errorMessage"></div>
            <div class="loading" id="loading">Loading season data... This may take a moment.</div>
        </div>

        <div class="chart-container" id="chartContainer">
            <div class="stats-summary" id="statsSummary"></div>
            <div class="chart-wrapper">
                <canvas id="trendsChart"></canvas>
            </div>
        </div>
    </div>

    <script>
        // Configuration
        const CONFIG = {
            API_KEY: 'YOUR_KENPOM_API_KEY_HERE', // Replace with your actual API key
            API_BASE: 'https://api.kenpom.com/api.php',
            SEASON_START_MONTH: 10, // November (0-indexed)
            SEASON_END_MONTH: 2, // March (0-indexed)
        };

        // State
        let currentData = null;
        let currentChart = null;
        let showingRankings = false;

        // D1 Basketball Teams (Major conferences + mid-majors)
        const teams = [
            // ACC
            "Clemson", "Duke", "Florida St.", "Georgia Tech", "Louisville", "Miami FL",
            "North Carolina", "NC State", "Notre Dame", "Pittsburgh", "Syracuse", "Virginia",
            "Virginia Tech", "Wake Forest", "Boston College",
            
            // Big 12
            "Baylor", "BYU", "Cincinnati", "Houston", "Iowa St.", "Kansas", "Kansas St.",
            "Oklahoma St.", "TCU", "Texas Tech", "UCF", "West Virginia",
            
            // Big East
            "Butler", "Creighton", "DePaul", "Georgetown", "Marquette", "Providence",
            "Seton Hall", "St. John's", "Villanova", "Xavier", "UConn",
            
            // Big Ten
            "Illinois", "Indiana", "Iowa", "Maryland", "Michigan", "Michigan St.",
            "Minnesota", "Nebraska", "Northwestern", "Ohio St.", "Penn St.", "Purdue",
            "Rutgers", "Wisconsin", "UCLA", "USC", "Oregon", "Washington",
            
            // SEC
            "Alabama", "Arkansas", "Auburn", "Florida", "Georgia", "Kentucky",
            "LSU", "Mississippi St.", "Missouri", "Ole Miss", "South Carolina",
            "Tennessee", "Texas A&M", "Vanderbilt", "Oklahoma", "Texas",
            
            // Pac-12
            "Arizona", "Arizona St.", "California", "Colorado", "Oregon St.",
            "Stanford", "Utah", "Washington St.",
            
            // American
            "Charlotte", "East Carolina", "FAU", "Memphis", "Navy", "North Texas",
            "Rice", "SMU", "South Florida", "Temple", "Tulane", "Tulsa", "UAB", "UTSA",
            
            // Mountain West
            "Air Force", "Boise St.", "Colorado St.", "Fresno St.", "Nevada",
            "New Mexico", "San Diego St.", "San Jose St.", "UNLV", "Utah St.", "Wyoming",
            
            // WCC
            "Gonzaga", "Loyola Marymount", "Pacific", "Pepperdine", "Portland",
            "Saint Mary's", "San Diego", "San Francisco", "Santa Clara",
            
            // Atlantic 10
            "Davidson", "Dayton", "Duquesne", "Fordham", "George Mason", "George Washington",
            "La Salle", "UMass", "Rhode Island", "Richmond", "Saint Joseph's", "St. Bonaventure",
            "Saint Louis", "VCU",
            
            // Other notable programs
            "Belmont", "Chattanooga", "College of Charleston", "Drake", "Grand Canyon",
            "Iona", "Liberty", "Murray St.", "New Mexico St.", "Northern Iowa",
            "Saint Peter's", "South Dakota St.", "Stephen F. Austin", "Vermont", "Winthrop"
        ].sort();

        // Initialize
        document.addEventListener('DOMContentLoaded', init);

        function init() {
            populateTeams();
            setupEventListeners();
        }

        function populateTeams() {
            const select = document.getElementById('teamSelect');
            teams.forEach(team => {
                const option = document.createElement('option');
                option.value = team;
                option.textContent = team;
                select.appendChild(option);
            });
        }

        function setupEventListeners() {
            document.getElementById('fetchBtn').addEventListener('click', fetchSeasonData);
            document.getElementById('toggleBtn').addEventListener('click', toggleView);
        }

        function getSundaysInSeason(year) {
            const sundays = [];
            const startDate = new Date(year - 1, CONFIG.SEASON_START_MONTH, 1);
            const endDate = new Date(year, CONFIG.SEASON_END_MONTH, 31);
            
            // Find first Sunday
            let current = new Date(startDate);
            while (current.getDay() !== 0) {
                current.setDate(current.getDate() + 1);
            }
            
            // Collect all Sundays
            while (current <= endDate) {
                sundays.push(new Date(current));
                current.setDate(current.getDate() + 7);
            }
            
            return sundays;
        }

        function formatDate(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        async function fetchSeasonData() {
            const team = document.getElementById('teamSelect').value;
            const year = parseInt(document.getElementById('yearSelect').value);
            
            if (!team) {
                showError('Please select a team');
                return;
            }
            
            // Show loading
            document.getElementById('loading').classList.add('active');
            document.getElementById('errorMessage').classList.remove('active');
            document.getElementById('chartContainer').classList.remove('active');
            document.getElementById('fetchBtn').disabled = true;
            
            try {
                const sundays = getSundaysInSeason(year);
                const dataPoints = [];
                
                // Fetch data for each Sunday
                for (const sunday of sundays) {
                    const dateStr = formatDate(sunday);
                    const data = await fetchKenPomData(dateStr, year, team);
                    
                    if (data) {
                        dataPoints.push({
                            date: sunday,
                            dateStr: dateStr,
                            ...data
                        });
                    }
                }
                
                if (dataPoints.length === 0) {
                    showError('No data found for this team and season. The season may not have started yet, or the team name may not match.');
                    return;
                }
                
                currentData = { team, year, dataPoints };
                displayChart();
                
            } catch (error) {
                console.error('Error fetching data:', error);
                showError(`Error loading data: ${error.message}`);
            } finally {
                document.getElementById('loading').classList.remove('active');
                document.getElementById('fetchBtn').disabled = false;
            }
        }

        async function fetchKenPomData(date, year, team) {
            const url = `${CONFIG.API_BASE}?endpoint=archive&d=${date}&y=${year}`;
            
            try {
                const response = await fetch(url, {
                    headers: {
                        'Authorization': `Bearer ${CONFIG.API_KEY}`
                    }
                });
                
                if (!response.ok) {
                    console.warn(`Failed to fetch data for ${date}`);
                    return null;
                }
                
                const data = await response.json();
                
                // Find the team in the response
                const teamData = data.find(t => t.TeamName === team);
                
                if (!teamData) {
                    return null;
                }
                
                return {
                    adjO: teamData.AdjOE,
                    adjD: teamData.AdjDE,
                    adjEM: teamData.AdjEM,
                    rankAdjO: teamData.RankAdjOE,
                    rankAdjD: teamData.RankAdjDE,
                    rankAdjEM: teamData.RankAdjEM
                };
                
            } catch (error) {
                console.warn(`Error fetching data for ${date}:`, error);
                return null;
            }
        }

        function displayChart() {
            if (!currentData || currentData.dataPoints.length === 0) {
                return;
            }
            
            const { team, dataPoints } = currentData;
            
            // Update stats summary
            const latest = dataPoints[dataPoints.length - 1];
            const summary = document.getElementById('statsSummary');
            summary.innerHTML = `
                <div class="stat-card">
                    <div class="stat-label">Latest AdjO</div>
                    <div class="stat-value">${latest.adjO.toFixed(1)}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Latest AdjD</div>
                    <div class="stat-value">${latest.adjD.toFixed(1)}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Latest Net Rating</div>
                    <div class="stat-value">${latest.adjEM.toFixed(1)}</div>
                </div>
                <div class="stat-card">
                    <div class="stat-label">Overall Rank</div>
                    <div class="stat-value">#${latest.rankAdjEM}</div>
                </div>
            `;
            
            // Create chart
            createChart();
            
            // Show container
            document.getElementById('chartContainer').classList.add('active');
            document.getElementById('toggleBtn').disabled = false;
        }

        function createChart() {
            const ctx = document.getElementById('trendsChart').getContext('2d');
            const { team, dataPoints } = currentData;
            
            // Destroy existing chart
            if (currentChart) {
                currentChart.destroy();
            }
            
            const labels = dataPoints.map(d => {
                const date = new Date(d.date);
                return `${date.getMonth() + 1}/${date.getDate()}`;
            });
            
            const datasets = showingRankings ? [
                {
                    label: 'Offensive Rank',
                    data: dataPoints.map(d => d.rankAdjO),
                    borderColor: 'rgb(102, 126, 234)',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.3
                },
                {
                    label: 'Defensive Rank',
                    data: dataPoints.map(d => d.rankAdjD),
                    borderColor: 'rgb(237, 100, 166)',
                    backgroundColor: 'rgba(237, 100, 166, 0.1)',
                    tension: 0.3
                },
                {
                    label: 'Overall Rank',
                    data: dataPoints.map(d => d.rankAdjEM),
                    borderColor: 'rgb(118, 75, 162)',
                    backgroundColor: 'rgba(118, 75, 162, 0.1)',
                    tension: 0.3
                }
            ] : [
                {
                    label: 'Adjusted Offense',
                    data: dataPoints.map(d => d.adjO),
                    borderColor: 'rgb(102, 126, 234)',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.3
                },
                {
                    label: 'Adjusted Defense',
                    data: dataPoints.map(d => d.adjD),
                    borderColor: 'rgb(237, 100, 166)',
                    backgroundColor: 'rgba(237, 100, 166, 0.1)',
                    tension: 0.3
                },
                {
                    label: 'Net Rating (AdjEM)',
                    data: dataPoints.map(d => d.adjEM),
                    borderColor: 'rgb(118, 75, 162)',
                    backgroundColor: 'rgba(118, 75, 162, 0.1)',
                    tension: 0.3
                }
            ];
            
            currentChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: datasets
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        title: {
                            display: true,
                            text: `${team} - ${showingRankings ? 'Rankings' : 'Metrics'} Trend`,
                            font: {
                                size: 18,
                                weight: 'bold'
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    let label = context.dataset.label || '';
                                    if (label) {
                                        label += ': ';
                                    }
                                    if (showingRankings) {
                                        label += '#' + Math.round(context.parsed.y);
                                    } else {
                                        label += context.parsed.y.toFixed(1);
                                    }
                                    return label;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            reverse: showingRankings,
                            beginAtZero: false,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return showingRankings ? '#' + value : value.toFixed(0);
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
        }

        function toggleView() {
            showingRankings = !showingRankings;
            document.getElementById('toggleBtn').textContent = 
                showingRankings ? 'Show Raw Values' : 'Show Rankings';
            document.getElementById('toggleBtn').classList.toggle('active');
            createChart();
        }

        function showError(message) {
            const errorDiv = document.getElementById('errorMessage');
            errorDiv.textContent = message;
            errorDiv.classList.add('active');
        }
    </script>
</body>
</html>
